# ============================================================================
# LUAN BARBER — VARIÁVEIS DE AMBIENTE
# ============================================================================

# Porta do servidor HTTP
PORT=3000

# Fuso horário padrão da barbearia (Padrão Brasileiro)
TZ=America/Sao_Paulo

# ============================================================================
# SUPABASE (BANCO DE DADOS POSTGRESQL E AUTENTICAÇÃO)
# ============================================================================
# Quando SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY estão preenchidos, o backend
# conecta diretamente ao PostgreSQL e Auth do seu projeto Supabase.
# Caso não estejam preenchidos no ambiente de desenvolvimento, o sistema utiliza
# automaticamente o banco relacional persistente local (data/luan_barber.db)
# mantendo a mesma estrutura relacional e transações atômicas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Caminho do arquivo de banco de dados persistente local (usado quando SUPABASE_URL está vazio)
SQLITE_DB_PATH=./data/luan_barber.db

# ============================================================================
# AUTENTICAÇÃO E SEGURANÇA ADMINISTRATIVA
# ============================================================================
# Chave secreta para assinatura de tokens de sessão administrativa (HMAC-SHA256)
AUTH_SECRET=luan-barber-secret-key-change-in-production-2026

# Credenciais iniciais do administrador Luan (criadas no primeiro boot se não existirem)
ADMIN_DEFAULT_NAME=Luan Barber
ADMIN_DEFAULT_EMAIL=luan@luanbarber.com.br
ADMIN_DEFAULT_PASSWORD=LuanBarber@2026

# ============================================================================
# INTEGRAÇÃO WHATSAPP BUSINESS API (NOTIFICAÇÕES REAIS)
# ============================================================================
# Provedores suportados:
#   - "meta_cloud" (API Oficial Meta WhatsApp Cloud API: graph.facebook.com)
#   - "evolution"  (Evolution API v2 compatível com WhatsApp Business)
#   - "zapi"       (Z-API WhatsApp HTTP endpoint)
#   - "webhook"    (Endpoint HTTP POST genérico JSON)
WHATSAPP_PROVIDER=meta_cloud

# Número de WhatsApp do Luan que receberá as notificações (com DDI 55 + DDD + Número)
LUAN_WHATSAPP_NUMBER=5511999999999

# Para Meta Cloud API Oficial:
# Exemplo URL: https://graph.facebook.com/v20.0
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=

# Tentativas automáticas máximas de reenvio em caso de falha de rede/API
WHATSAPP_MAX_RETRIES=3
